PORT=3000
MONGO_URI="mongodb://localhost:27017/whataspp-openai"

# Token inventado por vos; debe coincidir con el configurado en Meta.
WEBHOOK_VERIFY_TOKEN=cambia-este-token

# Datos de Meta Developers > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=pega-aqui-tu-token
WHATSAPP_PHONE_NUMBER_ID=pega-aqui-el-phone-number-id

# Usá la versión disponible en tu app de Meta; se deja configurable.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com

# Recomendado para producción. Se obtiene de la configuración básica de la app.
WHATSAPP_APP_SECRET=

# Opcional: si lo configurás, /api/messages exigirá Authorization: Bearer <valor>.
INTERNAL_API_KEY=

#LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe

#LIMITS
LLM_MONTHLY_WEB_SEARCH_LIMIT=100
LLM_MONTHLY_TEXT_QUERY_LIMIT=1000
LLM_MONTHLY_AUDIO_SECONDS_LIMIT=3600

#los primeros 1000 son gratis por parte de meta
WHATSAPP_MONTHLY_RESPONSE_LIMIT=2000

#OTROS
WAIT_BETWEEN_MESSAGES=30 #espera 30 segundos antes de responder el mensaje enviado por el cliente, para ver si llegan mas